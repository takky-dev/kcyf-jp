---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'KCYF — 仕事の毎日に、家族のあたたかさを';
const description = '子育て世代向けのアプリをつくる個人事業 KCYF の公式サイト。子どものお小遣い帳「おこっち」、小学生の学習アプリ「まなぶっち」。「仕事に追われる毎日でも、家族のあたたかさを手放さずにいられる社会」を目指しています。';
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-coral-light/60 via-base-bg to-base-bg pointer-events-none"></div>
    <div class="relative mx-auto max-w-5xl px-5 sm:px-6 pt-12 sm:pt-20 pb-16 sm:pb-24 text-center">
      <p class="text-sm sm:text-base text-coral-dark font-semibold tracking-wider mb-4">
        KCYF — Keep Connecting Your Family
      </p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight text-ink-primary">
        仕事に追われる毎日でも、<br />
        <span class="text-coral-dark">家族のあたたかさを</span><br class="sm:hidden" />手放さずに<br />いられる社会へ。
      </h1>
      <p class="mt-6 text-base sm:text-lg text-ink-secondary leading-relaxed max-w-2xl mx-auto">
        4人の子どもを育てる家族が、当事者としてつくる、<br class="sm:hidden" />
        家族の暮らしをそっと支えるアプリ。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href="/okocchi"
          class="inline-flex items-center gap-2 bg-coral text-white px-6 py-3 rounded-full font-semibold shadow-sm hover:bg-coral-dark transition-colors"
        >
          おこっちを見る →
        </a>
        <a
          href="/manabutchi"
          class="inline-flex items-center gap-2 bg-coral text-white px-6 py-3 rounded-full font-semibold shadow-sm hover:bg-coral-dark transition-colors"
        >
          まなぶっちを見る →
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-white text-ink-primary px-6 py-3 rounded-full font-semibold border border-coral-light hover:border-coral hover:text-coral-dark transition-colors"
        >
          お問い合わせ
        </a>
      </div>
    </div>
  </section>

  <!-- 私たちについて -->
  <section class="bg-coral-light/40">
    <div class="mx-auto max-w-4xl px-5 sm:px-6 py-14 sm:py-20">
      <h2 class="text-center text-2xl sm:text-3xl font-bold mb-4">私たちについて</h2>
      <div class="bg-white rounded-2xl p-7 sm:p-10 shadow-sm space-y-5 leading-relaxed text-ink-primary">
        <p>
          KCYF は <strong>4人の子どもを育てる</strong>代表が、家族とともに走る個人事業です。
        </p>
        <p>
          毎日の仕事に追われていても、<strong>子どもたちと向き合う時間</strong>だけは手放したくない。
          それは多くの子育て世代が抱える、すなおな願いだと思っています。
        </p>
        <p>
          当事者としての実感を、これまでの仕事で得た知見と組み合わせ、家族の暮らしをそっと支えるプロダクトを届けていきます。
        </p>
        <div class="pt-4 border-t border-coral-light/60">
          <p class="text-sm text-ink-secondary">
            <strong class="text-coral-dark">KCYF</strong> は <span class="font-semibold">Keep Connecting Your Family</span> の頭文字。
            「家族のつながりを、絶やさずに」という願いを込めた屋号です。
          </p>
        </div>
      </div>
      <p class="text-center text-sm text-ink-muted mt-6">
        <a href="/about" class="hover:text-coral-dark underline underline-offset-4">事業について詳しく →</a>
      </p>
    </div>
  </section>

  <!-- プロダクト紹介 -->
  <section class="mx-auto max-w-5xl px-5 sm:px-6 py-14 sm:py-20">
    <h2 class="text-center text-2xl sm:text-3xl font-bold mb-3">プロダクト</h2>
    <p class="text-center text-ink-secondary mb-10">
      子育て世代の小さな困りごとに、ひとつずつ向き合っていきます。
    </p>

    <a
      href="/okocchi"
      class="group block bg-white rounded-3xl p-7 sm:p-10 shadow-sm border border-coral-light/40 hover:border-coral transition-colors"
    >
      <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-8">
        <img
          src="/images/okocchi/icon.png"
          alt="おこっちアプリのアイコン"
          width="120"
          height="120"
          class="rounded-3xl shadow-md w-24 h-24 sm:w-28 sm:h-28"
        />
        <div class="flex-1 text-center sm:text-left">
          <p class="text-xs text-coral-dark font-semibold tracking-widest mb-1">FIRST PRODUCT</p>
          <h3 class="text-2xl font-bold mb-1 group-hover:text-coral-dark transition-colors">おこっち</h3>
          <p class="text-sm text-ink-secondary mb-3">何人でも使える子どものお小遣い帳</p>
          <p class="text-ink-primary leading-relaxed">
            きょうだいが多くてもOK。お子さま自身が「もらえた」「おかいもの」を記録できる、子ども目線のお小遣い帳アプリです。
          </p>
          <p class="mt-4 text-sm text-coral-dark font-semibold">
            アプリ紹介を見る →
          </p>
        </div>
      </div>
      <p class="text-xs text-ink-muted mt-5 text-center sm:text-right">
        <span class="text-coral-dark">App Store で配信中</span>
      </p>
    </a>

    <a
      href="/manabutchi"
      class="group mt-6 block bg-white rounded-3xl p-7 sm:p-10 shadow-sm border border-coral-light/40 hover:border-coral transition-colors"
    >
      <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-8">
        <img
          src="/images/manabutchi/icon.png"
          alt="まなぶっちアプリのアイコン"
          width="120"
          height="120"
          class="rounded-3xl shadow-md w-24 h-24 sm:w-28 sm:h-28"
        />
        <div class="flex-1 text-center sm:text-left">
          <p class="text-xs text-coral-dark font-semibold tracking-widest mb-1">LEARNING</p>
          <h3 class="text-2xl font-bold mb-1 group-hover:text-coral-dark transition-colors">まなぶっち</h3>
          <p class="text-sm text-ink-secondary mb-3">1セット3〜5分の、小学生の学習アプリ</p>
          <p class="text-ink-primary leading-relaxed">
            小学1年生の さんすう・こくご・せいかつ を、少しずつ。「きょうは おしまい」と言える学習アプリです。1年生の「きほん」から、6年間かけて中学受験のレベルまで広げていきます。
          </p>
          <p class="mt-4 text-sm text-coral-dark font-semibold">
            アプリ紹介を見る →
          </p>
        </div>
      </div>
      <p class="text-xs text-ink-muted mt-5 text-center sm:text-right">
        <span class="text-coral-dark">App Store で配信中（iPhone・iPad）</span>
      </p>
    </a>

    <!-- 家族の取り組み（2026-10-15 たっきー判断：おうちプリントは「家族の取り組み」として紹介する） -->
    <a
      href="https://ouchiprint.com/"
      target="_blank"
      rel="noopener"
      class="group mt-6 block bg-coral-light/30 rounded-2xl p-6 sm:p-8 border border-coral-light/60 hover:border-coral transition-colors"
    >
      <div class="flex items-start gap-4">
        <div class="text-4xl" aria-hidden="true">🖨️</div>
        <div class="flex-1">
          <p class="text-xs text-coral-dark font-semibold tracking-widest mb-2">FAMILY PROJECT — 家族の取り組み</p>
          <h3 class="text-xl font-bold mb-2 group-hover:text-coral-dark transition-colors">おうちプリント</h3>
          <p class="text-sm text-ink-secondary leading-relaxed">
            KCYFの家族がつくる、家で使える無料のプリント集です。幼児・小学生の知育ドリルや学習プリント、おこづかい表などの管理プリントを、わが家で実際に使ってから公開しています。
          </p>
          <p class="mt-3 text-sm text-coral-dark font-semibold">ouchiprint.com を見る →</p>
        </div>
      </div>
    </a>
  </section>
</BaseLayout>
