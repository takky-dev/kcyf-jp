---
const navItems = [
  { href: '/', label: 'ホーム' },
  { href: '/about', label: '事業について' },
  { href: '/okocchi', label: 'おこっち' },
  { href: '/contact', label: 'お問い合わせ' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="bg-base-bg/90 backdrop-blur sticky top-0 z-30 border-b border-coral-light/60">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 group">
      <span class="text-xl sm:text-2xl font-bold tracking-tight text-ink-primary group-hover:text-coral-dark transition-colors">
        KCYF
      </span>
      <span class="hidden sm:inline text-xs text-ink-muted">Keep Connecting Your Family</span>
    </a>

    <button
      id="nav-toggle"
      type="button"
      class="sm:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-ink-primary"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg class="nav-icon-open w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="nav-icon-close hidden w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="6" y1="18" x2="18" y2="6"></line>
      </svg>
    </button>

    <nav class="hidden sm:block">
      <ul class="flex items-center gap-1 sm:gap-2 text-sm">
        {navItems.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[
                'px-2 sm:px-3 py-2 rounded-md transition-colors',
                isActive(href)
                  ? 'text-coral-dark font-semibold'
                  : 'text-ink-secondary hover:text-coral-dark hover:bg-coral-light/40',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <nav id="mobile-nav" class="hidden sm:hidden border-t border-coral-light/40 bg-base-bg/95">
    <ul class="flex flex-col px-5 py-2">
      {navItems.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'block px-2 py-3 rounded-md transition-colors text-base',
              isActive(href)
                ? 'text-coral-dark font-semibold'
                : 'text-ink-secondary hover:text-coral-dark hover:bg-coral-light/40',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      btn.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
      btn.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
    });
  }
</script>
